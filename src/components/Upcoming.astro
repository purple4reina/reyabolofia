---
// Upcoming concerts, grouped by year. Past dates are removed at build time and
// again in the browser, and the whole section hides when nothing is scheduled.
import { upcoming } from '../data/performances';

interface Props {
  limit?: number;
  title?: string;
  id?: string;
  more?: { href: string; label: string };
}
const { limit = 99, title = 'Upcoming performances', id = 'upcoming', more } = Astro.props;
const all = upcoming();
const items = all.slice(0, limit);

const parts = (iso: string) => {
  const d = new Date(`${iso}:00`);
  return {
    year: d.getFullYear(),
    date: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
    when: `${d.toLocaleDateString('en-US', { weekday: 'long' })}, ${d
      .toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })
      .replace(':00', '')
      .replace('AM', 'am')
      .replace('PM', 'pm')}`,
  };
};

const rows: Array<{ year: number } | { item: (typeof items)[number] }> = [];
let lastYear = 0;
for (const item of items) {
  const y = parts(item.start).year;
  if (y !== lastYear) {
    rows.push({ year: y });
    lastYear = y;
  }
  rows.push({ item });
}
---

{
  items.length > 0 && (
    <section class="upcoming stage section" id={id} data-upcoming-section aria-labelledby={`${id}-title`}>
      <div class="wrap">
        <div class="head">
          <h2 id={`${id}-title`}>{title}</h2>
          {more && all.length > items.length && (
            <a class="btn" href={more.href}>
              {more.label}
            </a>
          )}
        </div>
        <ol class="list" role="list" data-upcoming>
          {rows.map((row) =>
            'year' in row ? (
              <li class="year" aria-hidden="true">
                {row.year}
              </li>
            ) : (
              (() => {
                const p = row.item;
                const d = parts(p.start);
                return (
                  <li class="show" data-start={p.start}>
                    <time class="when" datetime={p.start}>
                      <span class="date">{d.date}</span>
                      <span class="meta">
                        {d.when}
                        <span class="visually-hidden">, {d.year}</span>
                      </span>
                    </time>
                    <div class="what">
                      <span class="ensemble">{p.url ? <a href={p.url}>{p.ensemble}</a> : p.ensemble}</span>
                      {p.role && <span class="meta">{p.role}</span>}
                    </div>
                    <div class="where">
                      <span>{p.venue}</span>
                      <span class="meta">
                        {p.city}
                        {p.note && `. ${p.note}`}
                      </span>
                    </div>
                  </li>
                );
              })()
            ),
          )}
        </ol>
      </div>
    </section>
  )
}

<style>
  .upcoming {
    position: relative;
    z-index: 2;
    background: var(--stage-2);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  h2 {
    font-size: var(--fs-xl);
  }

  .year {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-2);
    padding: 28px 0 10px;
    border-bottom: 1px solid var(--line);
  }

  .year:first-child {
    padding-top: 0;
  }

  .show {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 1.4fr) minmax(0, 1.2fr);
    gap: 24px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .when,
  .what,
  .where {
    display: grid;
    gap: 4px;
  }

  .date {
    font-family: var(--serif);
    font-size: 1.75rem;
    line-height: 1;
  }

  .ensemble {
    font-family: var(--serif);
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .ensemble a {
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .show {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
