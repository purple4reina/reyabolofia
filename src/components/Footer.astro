---
import RingMark from './RingMark.astro';
import { mail, nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer stage" id="contact">
  <div class="wrap">
    <div class="top">
      <h2 class="title">Contact</h2>
      <a class="email" href={mail.general}>{site.email}</a>
    </div>

    <div class="bottom">
      <a class="brand" href="/">
        <RingMark size={22} />
        <span>{site.name}</span>
      </a>
      <nav aria-label="Footer">
        <ul role="list">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/press">Press kit</a></li>
          <li><a href="/orchestral">Orchestral</a></li>
          <li><a href={site.instagram} rel="me">Instagram</a></li>
        </ul>
      </nav>
      <p class="meta">
        Based in {site.home}. Portraits by {site.photoCredit}. © {year} {site.name}.
      </p>
    </div>
  </div>
</footer>

<style>
  /* At least a full screen tall (above the player bar, when it's open), so
     at the bottom of the page the section above has scrolled out of view.
     The email sits in the middle, the links at the bottom. */
  .site-footer {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--player-h));
    min-height: calc(100lvh - var(--player-h));
    padding-block: calc(var(--header-h) + 24px) 40px;
    border-top: 1px solid var(--line);
  }

  .site-footer > .wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .top {
    display: grid;
    gap: 20px;
    margin-block: auto;
  }

  .title {
    font-size: var(--fs-lg);
    font-style: italic;
    color: var(--ink-2);
  }

  .email {
    font-family: var(--display);
    font-size: clamp(2.1rem, 0.9rem + 5.6vw, 6.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    overflow-wrap: anywhere;
    width: fit-content;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition:
      background-size 0.6s var(--ease),
      color 0.3s;
    padding-bottom: 0.08em;
  }

  .email:hover {
    color: var(--lilac);
    background-size: 100% 1px;
  }

  .bottom {
    margin-top: clamp(72px, 9vw, 128px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-size: 1.15rem;
    text-decoration: none;
  }

  .bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: var(--fs-sm);
  }

  .bottom ul a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .bottom ul a:hover {
    color: var(--ink);
  }

  .bottom .meta {
    flex-basis: 100%;
  }
</style>
