---
import RingMark from './RingMark.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-header>
  <div class="bar wrap">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <RingMark size={26} />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a class="nav-contact" href="#contact">Contact</a></li>
      </ul>
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="menu" data-menu-button>
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav aria-label="Main">
      <ul role="list">
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
    <p class="menu-email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--ink);
    transition:
      transform 0.5s var(--ease),
      background-color 0.4s var(--ease);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(7 7 7 / 0.7), rgb(7 7 7 / 0));
    transition: opacity 0.4s var(--ease);
  }

  :global(.site-header.is-scrolled) {
    background: rgb(7 7 7 / 0.82);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }

  :global(.site-header.is-scrolled)::before {
    opacity: 0;
  }

  :global(.site-header.is-hidden) {
    transform: translateY(-100%);
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-name {
    font-family: var(--display);
    font-size: 1.3rem;
    letter-spacing: 0.005em;
  }

  .nav ul {
    display: flex;
    gap: clamp(16px, 2vw, 32px);
    margin: 0;
  }

  .nav a {
    font-size: var(--fs-sm);
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 8px;
    position: relative;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }

  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--lilac);
    transform: translateX(-50%);
  }

  .nav-contact {
    color: var(--lilac) !important;
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: 12px;
    background: none;
    border: 0;
    padding: 10px 0 10px 10px;
    color: var(--ink);
    font-size: var(--fs-sm);
  }

  .menu-icon {
    display: grid;
    gap: 6px;
    width: 22px;
  }

  .menu-icon span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s var(--ease);
  }

  .menu-button[aria-expanded='true'] .menu-icon span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-button[aria-expanded='true'] .menu-icon span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Hung from the bottom of the bar, not fixed to the viewport: the header's
     backdrop-filter (and its slide-away transform) would turn a fixed menu
     into one sized to the header, cutting it off after the first link. */
  .menu {
    position: absolute;
    inset: 100% 0 auto 0;
    height: calc(100vh - var(--header-h));
    height: calc(100dvh - var(--header-h));
    background: var(--stage);
    padding: 32px var(--gutter) 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
  }

  .menu[hidden] {
    display: none;
  }

  .menu ul {
    display: grid;
    gap: 6px;
  }

  .menu ul a {
    font-family: var(--serif);
    font-size: clamp(2rem, 9vw, 3rem);
    line-height: 1.15;
    text-decoration: none;
    color: var(--ink);
  }

  .menu ul a[aria-current='page'] {
    color: var(--lilac);
  }

  .menu-email a {
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .nav {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }
  }
</style>
